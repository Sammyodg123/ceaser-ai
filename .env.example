# ===== COPY THIS FILE TO ".env" ON THE SERVER. NEVER COMMIT ".env" OR PUT THESE IN THE FRONTEND =====
NODE_ENV=production
PORT=3000
APP_NAME=CEASER AI
APP_URL=https://yourdomain.com
CREATOR_NAME=Ceaser
CONTACT_EMAIL=you@gmail.com
ADMIN_EMAIL=you@gmail.com            # this account becomes admin when it signs up
FRONTEND_DIR=./site              # folder with the built website
DB_PATH=./data/app.db

# --- Gmail sending (verification / reset emails). Use an APP PASSWORD, not your real password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM="CEASER AI <you@gmail.com>"

# --- AI providers: fill in ONLY the keys you have. Each key adds a model to the chat's "Choose model" picker.
ANTHROPIC_API_KEY=            # Claude
AI_MODEL=claude-sonnet-4-5    # Claude model id
MANUS_API_KEY=                # Manus agent
MANUS_PROFILE=standard
MANUS_API_URL=https://api.manus.ai
OPENAI_API_KEY=               # OpenAI (OPENAI_MODEL=gpt-4o, OPENAI_BASE_URL optional)
GEMINI_API_KEY=               # Google Gemini (GEMINI_MODEL=gemini-2.0-flash)
DEEPSEEK_API_KEY=             # DeepSeek (DEEPSEEK_MODEL=deepseek-chat)
GROQ_API_KEY=                 # Groq (GROQ_MODEL=llama-3.3-70b-versatile)
OPENROUTER_API_KEY=           # OpenRouter (OPENROUTER_MODEL=openai/gpt-4o)
CUSTOM_API_KEY=               # any OpenAI-compatible API
CUSTOM_BASE_URL=              # e.g. https://api.example.com/v1
CUSTOM_MODEL=
# --- MORE AI PROVIDERS: fill only the ones you use. Each key adds models to the picker (they cost EXTRA_MODEL_COST x tokens).
# Several models for one provider:  OPENAI_MODELS="gpt-4o,gpt-4o-mini"   (works for every provider: <NAME>_MODELS / <NAME>_MODEL)
LLAMA_API_KEY=                # Meta Llama API (LLAMA_BASE_URL optional)
MISTRAL_API_KEY=
XAI_API_KEY=                  # Grok
TOGETHER_API_KEY=             # Llama and many open models
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
PERPLEXITY_API_KEY=
OLLAMA_BASE_URL=              # e.g. http://localhost:11434/v1  (your own server, no key needed)
# Optional full control of the picker (id|Label|Description|provider ; ...):
# AI_MODELS="claude-sonnet-4-5|Claude Sonnet|Balanced|anthropic;gpt-4o|GPT-4o|Fast all-rounder|openai"
# "Auto" (the default in the picker) uses AUTO_PROVIDER at normal token cost. Change it later when you are ready.
AUTO_PROVIDER=manus
# Picking any other model in the picker uses this many times more tokens:
EXTRA_MODEL_COST=2

# --- Flutterwave payments (or set these inside the app: Admin page). Webhook URL: https://YOUR-SITE/api/billing/webhook/flutterwave
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_CURRENCY=USD            # e.g. NGN, with FLW_RATE=1500 (local money per 1 USD)
# FLW_RATE=
PROMO_CODES=WELCOME10:10          # optional: CODE:percent-off

# --- FREE AI (no key needed). Shown in the picker as "Free AI"; used by Auto when no other key is set. FREE_AI=off to hide.
FREE_AI=on
# FREE_MODEL=openai
# Free-tier keys you can create yourself (all free): Groq console.groq.com, Gemini aistudio.google.com,
# OpenRouter openrouter.ai (use models ending in :free), Cerebras cloud.cerebras.ai, NVIDIA build.nvidia.com, Mistral console.mistral.ai
# e.g. OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free

# --- SMART AUTO ROUTING (what the "Auto" model does) ---------------------------------------------
# Websites / apps / bots / projects  -> WEBSITE_PROVIDERS (default: manus,anthropic)
# Code questions, bugs, scripts      -> CODE_PROVIDERS    (default: anthropic,manus)
# Normal chat                        -> CHAT_PROVIDERS    (default: every key you set, rotated so no single API is drained)
# If one fails before answering, the next one answers. The free AI is always the last resort.
# Pictures you upload only go to providers that can see images (Claude, OpenAI, Gemini, Free AI).
WEBSITE_PROVIDERS=manus,anthropic
CODE_PROVIDERS=anthropic,manus
# CHAT_PROVIDERS=groq,gemini,openrouter

# --- OMEGA AI ROUTING (api.omegatech.app; optional, unofficial) -----------------
# Set OMEGA_AI=on in Admin to expose these engines. Auto classifies each request:
# ordinary requests -> the censored pool; requests asking for blunt/direct style
# -> the uncensored pool. This changes tone/provider selection, not app safety rules.
OMEGA_AI=off
# OMEGA_MODELS=WormGPT,Qwen3-coder,Qwen,Claude,Chatai,Chatbot,llamacoder
# WormGPT is called through /api/ai/wormgpt?action=chat&message=...&newChat=true&forceNew=true

# --- IMAGE GENERATION (separate from chat). Tried in this order, first one that works wins ---------
IMAGE_PROVIDERS=custom,together,huggingface,pollinations,openai
# custom: any OpenAI-compatible images endpoint
# IMAGE_API_KEY=
# IMAGE_BASE_URL=https://your-provider.com/v1
# IMAGE_MODEL=
# together (free FLUX): uses TOGETHER_API_KEY above. Optional: IMAGE_TOGETHER_MODEL=black-forest-labs/FLUX.1-schnell-Free
# huggingface (free FLUX): HF_TOKEN=hf_xxx   Optional: IMAGE_HF_MODEL=black-forest-labs/FLUX.1-schnell
# pollinations needs no key. Turn off with IMAGE_FREE=off
# Generated pictures are stored here (Render free disk is wiped on redeploy):
# IMAGE_DIR=./data/images

# GEMINI_MODEL=gemini-2.5-flash   (gemini-2.0-flash is retired and answers 404)
# After deploy, open /api/chat/diagnose while logged in as admin: it shows the real HTTP status of every provider.

# The admin account (ADMIN_EMAIL) gets an Admin page in the menu: edit every key above, test engines, restart. Saved to data/settings.json.
# FREE_CODE_MODEL=qwen-coder   (free AI model used for coding/building)
