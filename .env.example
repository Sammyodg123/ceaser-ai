# ===== COPY THIS FILE TO ".env" ON THE SERVER. NEVER COMMIT ".env" OR PUT THESE IN THE FRONTEND =====
NODE_ENV=production
PORT=3000
APP_NAME=CEASER AI
APP_URL=https://yourdomain.com
CREATOR_NAME=Ceaser
CONTACT_EMAIL=you@gmail.com
ADMIN_EMAIL=you@gmail.com            # this account becomes admin when it signs up
FRONTEND_DIR=./site              # folder with the built website
DB_PATH=./data/app.db

# --- Gmail sending (verification / reset emails). Use an APP PASSWORD, not your real password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM="CEASER AI <you@gmail.com>"

# --- AI providers: fill in ONLY the keys you have. Each key adds a model to the chat's "Choose model" picker.
ANTHROPIC_API_KEY=            # Claude
AI_MODEL=claude-sonnet-4-5    # Claude model id
MANUS_API_KEY=                # Manus agent
MANUS_PROFILE=standard
MANUS_API_URL=https://api.manus.ai
OPENAI_API_KEY=               # OpenAI (OPENAI_MODEL=gpt-4o, OPENAI_BASE_URL optional)
GEMINI_API_KEY=               # Google Gemini (GEMINI_MODEL=gemini-2.0-flash)
DEEPSEEK_API_KEY=             # DeepSeek (DEEPSEEK_MODEL=deepseek-chat)
GROQ_API_KEY=                 # Groq (GROQ_MODEL=llama-3.3-70b-versatile)
OPENROUTER_API_KEY=           # OpenRouter (OPENROUTER_MODEL=openai/gpt-4o)
CUSTOM_API_KEY=               # any OpenAI-compatible API
CUSTOM_BASE_URL=              # e.g. https://api.example.com/v1
CUSTOM_MODEL=
# --- MORE AI PROVIDERS: fill only the ones you use. Each key adds models to the picker (they cost EXTRA_MODEL_COST x tokens).
# Several models for one provider:  OPENAI_MODELS="gpt-4o,gpt-4o-mini"   (works for every provider: <NAME>_MODELS / <NAME>_MODEL)
LLAMA_API_KEY=                # Meta Llama API (LLAMA_BASE_URL optional)
MISTRAL_API_KEY=
XAI_API_KEY=                  # Grok
TOGETHER_API_KEY=             # Llama and many open models
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
PERPLEXITY_API_KEY=
OLLAMA_BASE_URL=              # e.g. http://localhost:11434/v1  (your own server, no key needed)
# Optional full control of the picker (id|Label|Description|provider ; ...):
# AI_MODELS="claude-sonnet-4-5|Claude Sonnet|Balanced|anthropic;gpt-4o|GPT-4o|Fast all-rounder|openai"
# "Auto" (the default in the picker) uses AUTO_PROVIDER at normal token cost. Change it later when you are ready.
AUTO_PROVIDER=manus
# Picking any other model in the picker uses this many times more tokens:
EXTRA_MODEL_COST=2

# --- Stripe (leave empty to hide the option)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayPal (leave empty to hide the option). Use https://api-m.sandbox.paypal.com to test
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API=https://api-m.paypal.com
PROMO_CODES=WELCOME10:10          # optional: CODE:percent-off
